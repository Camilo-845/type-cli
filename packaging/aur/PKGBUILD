# Maintainer: Camilo <camilo.sarmiento.amado at gmail dot com>
pkgname=type-cli
pkgver=0.4.4
pkgrel=1
pkgdesc="Terminal-based typing speed test"
arch=('x86_64' 'aarch64')
url="https://github.com/Camilo-845/type-cli"
license=('MIT')
depends=('glibc')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('75843a7b176a36ec171dac27d9bfad891cb1a21dc1561a00e11106b80310abee')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export GOPROXY=off
  export GOSUMDB=off
  export GOFLAGS=-mod=vendor
  go build -trimpath -ldflags='-s -w' -o tcli .
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 tcli "$pkgdir/usr/bin/tcli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
